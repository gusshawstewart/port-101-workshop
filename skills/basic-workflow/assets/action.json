{
  "identifier": "scaffold_new_service",
  "title": "Scaffold New Service",
  "icon": "Microservice",
  "description": "Register a new service in the catalog",
  "nodes": [
    {
      "identifier": "trigger",
      "title": "Scaffold New Service",
      "icon": "Microservice",
      "config": {
        "type": "SELF_SERVE_TRIGGER",
        "userInputs": {
          "properties": {
            "identifier": {
              "title": "Service Identifier",
              "description": "Lowercase, hyphenated (e.g. payments-service)",
              "type": "string"
            },
            "title": {
              "title": "Service Title",
              "type": "string"
            },
            "language": {
              "title": "Language",
              "type": "string",
              "default": "Node.js",
              "enum": ["Go", "Python", "Node.js", "Java", "TypeScript"]
            },
            "lifecycle": {
              "title": "Lifecycle",
              "type": "string",
              "default": "Experimental",
              "enum": ["Production", "Staging", "Experimental"],
              "enumColors": {
                "Production": "red",
                "Staging": "yellow",
                "Experimental": "green"
              }
            },
            "tier": {
              "title": "Tier",
              "type": "string",
              "default": "Tier 3",
              "enum": ["Tier 1", "Tier 2", "Tier 3"]
            },
            "on_call": {
              "title": "On-Call Owner",
              "type": "string",
              "default": ""
            },
            "repo_url": {
              "title": "Repository URL",
              "type": "string",
              "format": "url",
              "default": ""
            }
          },
          "required": ["identifier", "title", "language"],
          "order": [
            "identifier",
            "title",
            "language",
            "lifecycle",
            "tier",
            "on_call",
            "repo_url"
          ]
        },
        "actionCardButtonText": "Scaffold",
        "executeActionButtonText": "Create Service",
        "published": true
      }
    }
  ],
  "connections": []
}
