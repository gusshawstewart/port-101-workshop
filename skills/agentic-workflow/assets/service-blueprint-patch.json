          "Production": "red",
          "Staging": "yellow",
          "Experimental": "green"
        }
      },
      "tier": {
        "title": "Tier",
        "type": "string",
        "enum": ["Tier 1", "Tier 2", "Tier 3"],
        "enumColors": {
          "Tier 1": "red",
          "Tier 2": "yellow",
          "Tier 3": "lightGray"
        }
      },
      "on_call": {
        "title": "On-Call Owner",
        "type": "string"
      },
      "has_readme": {
        "title": "Has README",
